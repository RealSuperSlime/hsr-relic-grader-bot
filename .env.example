# ---------------------------------------------------------------------------
# HSR Relic Grader - bot settings
#
# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
#
# .env is git-ignored (see .gitignore), so your token never gets uploaded.
# This example file is safe to share: it contains no real credentials.
# ---------------------------------------------------------------------------

# Your Discord bot token, from https://discord.com/developers/applications
# -> your app -> Bot -> Reset Token.
# Paste ONLY the token - no "Bot " prefix, no quotes, no extra lines.
DISCORD_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Optional. Your server ID (Discord -> User Settings -> Advanced ->
# Developer Mode on, then right-click the server -> Copy Server ID).
# With this set, slash commands appear instantly instead of waiting on
# Discord's global propagation, which can take up to an hour.
# DISCORD_GUILD_ID=

# Optional. Overrides the default prefix for text commands (! by default).
# BOT_PREFIX=!
